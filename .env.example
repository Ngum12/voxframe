# Voxframe configuration — all optional.
#
# Copy to .env and uncomment what you need:  cp .env.example .env
#
# Voxframe runs fully offline with none of this set. Every value below either
# tunes behaviour or enables an OPTIONAL feature. No key is ever required.
#
# .env is gitignored. Never commit real keys.

# ---------------------------------------------------------------------------
# Paths
# ---------------------------------------------------------------------------
# VOXFRAME_LIBRARY_PATH=./library
# VOXFRAME_CACHE_PATH=./.voxframe_cache
# VOXFRAME_OUTPUT_PATH=./demo_output

# If ffmpeg is not on your PATH, point at it directly.
# VOXFRAME_FFMPEG_PATH=C:/ffmpeg/bin/ffmpeg.exe

# ---------------------------------------------------------------------------
# Render defaults
# ---------------------------------------------------------------------------
# VOXFRAME_FPS=30
# VOXFRAME_ASPECT=16:9           # 9:16 | 16:9 | 1:1
# VOXFRAME_QUALITY=standard      # draft | standard | high | ultra
# VOXFRAME_INTERMEDIATE=x264-crf16   # x264-crf16 | ffv1  (see DECISIONS.md D-016)

# ---------------------------------------------------------------------------
# Models (see DECISIONS.md D-066, D-067)
# ---------------------------------------------------------------------------
# One setting covers every model download:
#   standard  ~3 GB    large-v3-turbo + multilingual embedder. Best accuracy.
#   lite      ~750 MB  base + laion2b embedder. French retrieval is materially
#                      weaker (68% vs 80% top-1); English is comparable.
# VOXFRAME_PROFILE=standard

# Override either model individually. Unset follows the profile.
# VOXFRAME_TRANSCRIBE_MODEL=large-v3-turbo   # tiny|base|small|medium|large-v3|large-v3-turbo
# VOXFRAME_EMBED_MODEL=default               # default | lite

# The transcription model is recorded in the plan when the plan is created and
# is never changed by a re-render, because new word timings would invalidate
# caption corrections. Use `voxframe retranscribe` to change it deliberately.

# ---------------------------------------------------------------------------
# Language (see DECISIONS.md D-061, D-068)
# ---------------------------------------------------------------------------
# Whisper can misdetect the language on accented speech and then drop audio
# while reporting success. On a real accented English recording, `small`
# detected Yoruba and lost half the words.
#
# Restricting detection to a candidate set fixes that while keeping detection
# working, which is what you want for a mixed-language project. Measured on
# that recording: the restricted transcript is identical to a forced one.
# VOXFRAME_LANGUAGES=en,fr

# Or skip detection entirely. Simplest when everything you make is one
# language, and it means not passing --language every time.
# VOXFRAME_LANGUAGE=en

# ---------------------------------------------------------------------------
# Pacing — how often the visual changes
# ---------------------------------------------------------------------------
# VOXFRAME_SCENE_MIN_SECONDS=4.0
# VOXFRAME_SCENE_MAX_SECONDS=8.0

# ---------------------------------------------------------------------------
# Motion (see DECISIONS.md D-007)
# ---------------------------------------------------------------------------
# VOXFRAME_PARALLAX_ENABLED=true
# Max parallax offset as a fraction of image width. Higher looks more dramatic
# but exposes larger gaps behind the foreground, which become visible artefacts.
# VOXFRAME_PARALLAX_MAX_DISPLACEMENT=0.04
# Below this depth-separation score, a scene falls back to Ken Burns motion.
# VOXFRAME_DEPTH_QUALITY_THRESHOLD=0.45

# ---------------------------------------------------------------------------
# Hardware
# ---------------------------------------------------------------------------
# VOXFRAME_USE_GPU=true          # Used when available; never required.
# VOXFRAME_THREADS=0             # 0 = auto-detect

# ---------------------------------------------------------------------------
# Sourcing behaviour (Phase 4)
# ---------------------------------------------------------------------------
# Search order. "local" is your own library, always searched first; adapters
# without a key are skipped silently.
# VOXFRAME_SOURCE_ORDER=local,pexels,pixabay,openverse

# Fill scenes with stills, video clips, or both.
# VOXFRAME_MEDIA_MIX=mixed        # stills | clips | mixed
# VOXFRAME_CLIP_RATIO=0.35        # target fraction of scenes using clips

# Download caps. Clips are far larger than stills.
# VOXFRAME_MAX_CLIP_MB=25
# VOXFRAME_MAX_DOWNLOAD_MB=400

# Minimum CLIP similarity for a match. Measured on real stock photographs
# (D-081): 0.17 keeps 70% of apt matches and admits no irrelevant ones. Scenes
# below it render as a gradient, which is better than a wrong image.
# VOXFRAME_SIMILARITY_THRESHOLD=0.17

# ---------------------------------------------------------------------------
# OPTIONAL: stock image and video sources (Phase 4)
# ---------------------------------------------------------------------------
# Each adapter stays off unless its key is set, and Voxframe works with none of
# them: the keyless Openverse adapter runs first, and scenes that still match
# nothing render as a gradient. No key is ever required.
#
# Your own library is always searched first, whatever is configured.
#
# Pexels — free key, 200 requests/hour and 20,000/month.
# Register at https://www.pexels.com/api/
# VOXFRAME_PEXELS_API_KEY=
#
# Pixabay — free key, 100 requests per 60 seconds.
# Register at https://pixabay.com/api/docs/
# VOXFRAME_PIXABAY_API_KEY=
#
# https://unsplash.com/developers
# VOXFRAME_UNSPLASH_ACCESS_KEY=
#
# Openverse needs no key.
#
# Keys are read only from the environment or this file, are redacted from every
# log line, error message, cache key and scene plan, and are never written into
# a rendered output. `voxframe sources` shows which adapters are active without
# revealing them.

# ---------------------------------------------------------------------------
# OPTIONAL: AI director (Phase 7)
# ---------------------------------------------------------------------------
# Improves image choices and emphasis. Voxframe produces good results without it.
#
# Anthropic (paid API):
# VOXFRAME_ANTHROPIC_API_KEY=
#
# Ollama (free, local — no key, no data leaves your machine):
# VOXFRAME_OLLAMA_HOST=http://localhost:11434
